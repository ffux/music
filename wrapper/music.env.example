# Optional explicit production settings; these match the app defaults.
MUSIC_USE_WRAPPER=true
# Strict ALAC: never silently fall back to lossy AAC.
MUSIC_SONG_CODEC_PRIORITY=alac
MUSIC_WRAPPER_URL=http://music-wrapper
MUSIC_WRAPPER_DECRYPT_HOST=music-wrapper
MUSIC_WRAPPER_DECRYPT_PORT=10020
# Empty subdirectory writes new downloads into the normal library.
MUSIC_DOWNLOAD_SUBDIR=
